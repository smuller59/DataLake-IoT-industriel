# Copier ce fichier en .env et renseigner les valeurs avant de lancer `docker compose up`.

# === MinIO ===
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://localhost:9000

# === Airflow ===
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:changeme@postgres/airflow

# === Postgres (Airflow) ===
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

# === Postgres (OpenMetadata) ===
OPENMETA_POSTGRES_USER=postgres
OPENMETA_POSTGRES_PASSWORD=changeme
OPENMETA_DB_USER=openmetadata_user
OPENMETA_DB_USER_PASSWORD=changeme
OPENMETA_DATABASE=openmetadata_db

# === OpenMetadata server ===
# Générer une clé Fernet dédiée (ex: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
OPENMETA_FERNET_KEY=
# Token du bot d'ingestion OpenMetadata : Settings > Bots > ingestion-bot dans l'UI OpenMetadata
OPENMETADATA_JWT_TOKEN=
